# ============================================================================
# ПРОГРАМНО-АНАЛІТИЧНИЙ КОМПЛЕКС ОБРОБКИ ТА АНАЛІЗУ ВЕЛИКИХ ДАНИХ
# ПУНКТУАЛЬНОСТІ АВІАРЕЙСІВ І ЧИННИКІВ ЗАТРИМОК ("ПАКАПА" - Варіант 3)
# ============================================================================

# PostgreSQL Analytics Warehouse (Gold Layer + Stream Sink + Metadata)
PG_HOST=localhost
PG_PORT=5432
PG_DB=flights_dw
PG_USER=flights_user
PG_PASSWORD=flights_pass

# Apache Kafka (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_LIVE=flights.live.stream
KAFKA_TOPIC_DLQ=flights.dlq

# OpenSky Network API (Live Aviation Feed)
# Може працювати анонімно без ключів або з OAuth2/Basic Auth
OPENSKY_MODE=auto
OPENSKY_BBOX_LAMIN=-55.0
OPENSKY_BBOX_LOMIN=-175.0
OPENSKY_BBOX_LAMAX=70.0
OPENSKY_BBOX_LOMAX=175.0
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Medallion Data Lake Paths
DATA_DIR=data
RAW_DIR=data/raw
BRONZE_DIR=data/lake/bronze
SILVER_DIR=data/lake/silver
GOLD_DIR=data/lake/gold
QUARANTINE_DIR=data/lake/quarantine
MODELS_DIR=models
BACKUP_DIR=backups

# Dataset Scale Configuration
BTS_NUM_RECORDS=100000
BTS_RANDOM_SEED=42
